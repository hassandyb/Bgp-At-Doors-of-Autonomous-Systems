# Loopback
ip link set lo up
ip addr add 1.1.1.2/32 dev lo

# Underlay to RR
ip addr add 10.1.1.2/30 dev eth0
ip link set eth0 up

# Host-facing interface
ip link set eth1 up

# VXLAN — nolearning because BGP EVPN handles MACs
ip link add vxlan10 type vxlan id 10 \
  local 1.1.1.2 \
  dstport 4789 \
  nolearning

ip link set vxlan10 up

# Bridge — connects host port + vxlan tunnel
ip link add br0 type bridge
ip link set br0 up
ip link set eth1 master br0
ip link set vxlan10 master br0
```

