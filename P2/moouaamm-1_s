# Assign IP address to the underlay interface (eth0)
/sbin/ip addr add 10.1.1.1/24 dev eth0

# Create VXLAN interface (unicast mode) 
# id 10 — this is the VNI. Both routers must use the same VNI for frames to be delivered to the right overlay network.
# dev eth0 — this tells the kernel to use eth0 as the underlay, meaning VXLAN packets travel via eth0.
# local 10.1.1.1 — this router's VTEP IP. The source IP in the outer UDP packet.
# remote 10.1.1.2 — the other router's VTEP IP. This is what makes it static — we hardcode the destination. Router 2 has it reversed.
# dstport 4789 — the standard VXLAN UDP port defined in RFC 7348."
/sbin/ip link add name vxlan10 type vxlan \
    id 10 \
    dev eth0 \
    local 10.1.1.1 \
    remote 10.1.1.2 \
    dstport 4789
# Bring up the VXLAN interface
/sbin/ip link set dev vxlan10 up

# Create a Linux bridge
/sbin/ip link add br0 type bridge

# Bring up the bridge
/sbin/ip link set dev br0 up

# Add physical interface to the bridge
brctl addif br0 eth1

# Add VXLAN interface to the bridge
brctl addif br0 vxlan10
