# Assign an IP address to eth0 (underlay interface)
/sbin/ip addr add 10.1.1.1/24 dev eth0

# Create VXLAN interface vxlan10 id: VXLAN Network Identifier (VNI) - dev: underlay interface - group: multicast group used for VXLAN flooding - dstport: VXLAN UDP port (default 4789)
/sbin/ip link add name vxlan10 type vxlan \
    id 10 \
    dev eth0 \
    group 239.1.1.1 \
    dstport 4789

# Bring up the VXLAN interface
/sbin/ip link set dev vxlan10 up

# Create a Linux bridge
/sbin/ip link add br0 type bridge

# Bring up the bridge interface
/sbin/ip link set dev br0 up

# Add physical interface to the bridge
brctl addif br0 eth1

# Add VXLAN interface to the bridge
brctl addif br0 vxlan10
